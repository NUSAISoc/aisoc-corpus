{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aisoc-corpus",
  "compatibility_date": "2026-08-02",
  "build": {
    "command": "npm run build",
  },
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"],
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
  "triggers": {
    "crons": ["15 0 1 * *"],
  },
  "vars": {
    "GITHUB_OWNER": "NUSAISoc",
    "GITHUB_REPO": "aisoc-corpus",
    "GITHUB_BASE_BRANCH": "main",
    "ANALYTICS_DATASET": "aisoc_corpus_pageviews",
    "CLOUDFLARE_ACCOUNT_ID": "cee1e2ca0c4e238733bdb5e955b1596a",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
