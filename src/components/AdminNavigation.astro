---
const links = [
  { href: "/", label: "Graph" },
  { href: "/admin/signal-deck/", label: "Signal Deck" },
  { href: "/admin/new-topic/", label: "New Topic" },
  { href: "/admin/reports/", label: "Monthly Poster" },
];

const pathname = Astro.url?.pathname ?? "/admin/";
---

<nav class="navbar" aria-label="Admin navigation">
  <div class="container navbar__inner">
    <a class="navbar__brand" href="/">
      <span>NUS AI Society</span>
      <strong>AI Soc Corpus</strong>
    </a>
    <div class="navbar__links">
      {
        links.map(({ href, label }) => {
          const isActive = href.startsWith("/admin/") && pathname === href;
          return (
            <a
              href={href}
              class:list={["navbar__link", isActive && "navbar__link--active"]}
            >
              {label}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>
