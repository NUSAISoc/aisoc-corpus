---
import {
  DEFAULT_DESCRIPTION,
  SITE_NAME,
  organizationSchema,
  serializeJsonLd,
  socialImageUrl,
  canonicalUrl,
  robotsDirective,
} from "../lib/seo";
import { GOOGLE_SITE_VERIFICATION } from "../config/site";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: unknown | unknown[];
  indexable?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  image,
  type = "website",
  jsonLd = [],
  indexable = true,
} = Astro.props;
const canonical = canonicalUrl(canonicalPath);
const socialImage = socialImageUrl(image);
const jsonLdItems = [
  organizationSchema(),
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
].filter(Boolean);
const jsonLdScript = serializeJsonLd(jsonLdItems);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsDirective(indexable)} />
{
  GOOGLE_SITE_VERIFICATION && (
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
  )
}
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME} knowledge graph`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={`${SITE_NAME} knowledge graph`} />

<script is:inline type="application/ld+json" set:html={jsonLdScript} />
