---
import Navigation from "../components/Navigation.astro";
import AdminNavigation from "../components/AdminNavigation.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  jsonLd?: unknown | unknown[];
  indexable?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image,
  jsonLd,
  indexable = !Astro.url.pathname.startsWith("/admin"),
} = Astro.props;
const pageTitle = title ? `${title} | AI Soc Corpus` : "AI Soc Corpus";
const isAdminRoute = Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoHead
      title={pageTitle}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      jsonLd={jsonLd}
      indexable={indexable}
    />
  </head>
  <body class="site-shell">
    <div aria-hidden="true" class="site-backdrop"></div>
    {isAdminRoute ? <AdminNavigation /> : <Navigation />}
    <main class="site-main">
      <div class="container">
        <div class="content-frame">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
    <script is:inline>
      (() => {
        if (location.pathname.startsWith("/admin")) return;
        const payload = {
          path: location.pathname,
          title: document.title,
          referrer: document.referrer,
          width: window.innerWidth,
          height: window.innerHeight,
        };
        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          navigator.sendBeacon(
            "/api/analytics/pageview",
            new Blob([body], { type: "application/json" }),
          );
          return;
        }
        fetch("/api/analytics/pageview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      })();
    </script>
  </body>
</html>
