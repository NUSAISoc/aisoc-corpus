---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
---

<BaseLayout
  title="Admin Dashboard"
  description="Admin page."
  canonicalPath="/admin/"
>
  <section class="admin-shell">
    <div class="admin-hero">
      <p class="admin-kicker">Admin</p>
      <h1>Admin page</h1>
    </div>
    <div class="admin-grid">
      <a class="admin-card" href="/admin/signal-deck/"
        ><span>Analytics</span><h2>Signal Deck</h2></a
      >
      <a class="admin-card" href="/admin/new-topic/"
        ><span>Submission</span><h2>New topic</h2></a
      >
      <a class="admin-card" href="/admin/reports/"
        ><span>Report</span><h2>Monthly poster</h2></a
      >
    </div>
  </section>
</BaseLayout>
