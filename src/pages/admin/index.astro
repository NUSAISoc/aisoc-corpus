---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
---

<BaseLayout
  title="Admin Dashboard"
  description="AI Soc Corpus admin dashboard for analytics, submissions, and contributor reports."
  canonicalPath="/admin/"
>
  <section class="admin-shell">
    <div class="admin-hero">
      <div>
        <p class="admin-kicker">Corpus operations</p>
        <h1>The dashboard that keeps the graph alive.</h1>
        <p>
          Track reader attention, collect contributor drafts without forcing the
          GitHub flow, and generate monthly recognition posters for NUS AI
          Society channels.
        </p>
      </div>
      <div class="admin-stat">
        <strong>03</strong><span>Live admin surfaces</span>
      </div>
    </div>
    <div class="admin-grid">
      <a class="admin-card" href="/admin/signal-deck/"
        ><span>Analytics</span><h2>Signal Deck</h2><p>
          See top pages, traffic sources, devices, geography, and usage rhythm.
        </p></a
      >
      <a class="admin-card" href="/admin/new-topic/"
        ><span>Submission intake</span><h2>Add new page</h2><p>
          Create validated markdown, upload images, and open a GitHub pull
          request.
        </p></a
      >
      <a class="admin-card" href="/admin/reports/"
        ><span>Recognition</span><h2>Monthly poster</h2><p>
          Preview and download last month&apos;s contributor poster.
        </p></a
      >
    </div>
  </section>
</BaseLayout>
