---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
---

<BaseLayout
  title="Signal Deck"
  description="Analytics overview."
  canonicalPath="/admin/signal-deck/"
>
  <section class="admin-shell">
    <div class="admin-hero">
      <div class="admin-page-header">
        <a class="admin-back" href="/admin/">&larr; Admin</a>
        <div>
          <h1>Signal Deck</h1>
        </div>
      </div>
    </div>
    <section class="metric-grid">
      <div class="metric">
        <span>Total views</span><strong id="total-views">0</strong>
      </div><div class="metric">
        <span>Unique pages</span><strong id="unique-pages">0</strong>
      </div><div class="metric">
        <span>Top device</span><strong id="top-device">-</strong>
      </div>
    </section>
    <section class="admin-panel">
      <h2>Top pages</h2><div class="bar-list" id="top-pages"></div>
    </section>
    <section class="admin-grid">
      <div class="admin-panel">
        <h2>Referrers</h2><div class="bar-list" id="referrers"></div>
      </div><div class="admin-panel">
        <h2>Countries</h2><div class="bar-list" id="countries"></div>
      </div>
    </section>
    <p class="admin-status" id="status" role="status">Loading Signal Deck...</p>
  </section>
  <script is:inline src="/ops-assets/signal-deck.js" defer></script>
</BaseLayout>
