---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
---

<BaseLayout
  title="Admin Login"
  description="Password-protected access to AI Soc Corpus admin tools."
  canonicalPath="/admin/login/"
>
  <section class="admin-shell">
    <div class="admin-hero">
      <div>
        <p class="admin-kicker">Restricted console</p>
        <h1>Admin access</h1>
        <p>
          Enter the shared corpus admin password to access Signal Deck, topic
          submissions, and monthly contributor posters.
        </p>
      </div>
      <div class="admin-stat">
        <strong>01</strong><span>One password, three tools</span>
      </div>
    </div>
    <form class="admin-form admin-panel" id="login-form">
      <label
        >Password <input
          name="password"
          type="password"
          autocomplete="current-password"
          required
        /></label
      >
      <button class="admin-button" type="submit">Unlock dashboard</button>
      <p class="admin-status" id="login-status" role="status"></p>
    </form>
  </section>
  <script is:inline src="/ops-assets/login.js" defer></script>
</BaseLayout>
