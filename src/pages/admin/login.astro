---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
---

<BaseLayout
  title="Admin Login"
  description="Admin login."
  canonicalPath="/admin/login/"
>
  <section class="admin-shell">
    <div class="admin-hero">
      <p class="admin-kicker">Admin</p>
      <h1>Admin login</h1>
    </div>
    <form class="admin-form admin-panel" id="login-form">
      <label
        >Password <input
          name="password"
          type="password"
          autocomplete="current-password"
          required
        /></label
      >
      <button class="admin-button" type="submit">Unlock dashboard</button>
      <p class="admin-status" id="login-status" role="status"></p>
    </form>
  </section>
  <script is:inline src="/ops-assets/login.js" defer></script>
</BaseLayout>
